# ══════════════════════════════════════════════════════════
#  Enterprise Knowledge Voice Assistant – environment vars
#  Copy to .env and fill in your values (never commit .env)
# ══════════════════════════════════════════════════════════

# ── LLM: Groq (free tier) ─────────────────────────────────
# Get key at: https://console.groq.com  (free, no card needed)
GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b

# ── LLM: OpenAI-compatible alternative (optional) ─────────
# Leave empty to use Groq. Fill to use vLLM / OpenAI instead.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Auth ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-32-chars-minimum
JWT_EXPIRE_MINUTES=480

# ── Optional services (auto-detected when set) ────────────
REDIS_URL=          # e.g. redis://localhost:6379
